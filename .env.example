# Tickr environment — copy to .env and fill in what you have.
# Everything is optional except where noted: with no keys at all the app still
# runs (offline synthesis, no accounts). Never commit the real .env.

# ── Server ───────────────────────────────────────────────────────────────
PORT=3005
# Public origin of the app; used in emailed links and to decide Secure cookies
# + HSTS. Set to your real https URL in production.
APP_URL=http://localhost:3005
# Set to 1 (or the hop count) when running behind a reverse proxy so rate
# limiting sees real client IPs instead of the proxy's.
TRUST_PROXY=
# Python interpreter for the data tier. Point outside iCloud on macOS —
# imports from an iCloud-synced .venv can stall for minutes.
TICKR_PYTHON=
# Max concurrent Python data processes (default 4).
PY_MAX_CONCURRENCY=

# ── Accounts (MongoDB) ───────────────────────────────────────────────────
# With MONGODB_URI unset, accounts are disabled and data lives in web/data/
# (single-user local mode). With it set, signup/login/2FA are required.
MONGODB_URI=
MONGODB_DB=tickr
# REQUIRED when accounts are on: signs session JWTs. Use a long random string
# (e.g. `openssl rand -hex 32`). Changing it logs everyone out.
JWT_SECRET=
# Session length (default 7d).
JWT_TTL=
# Encrypts note text at rest (falls back to JWT_SECRET if unset).
ENCRYPTION_KEY=

# ── Email (Resend) — verification links + login OTP codes ────────────────
# Without a key, emails are printed to the server log (fine for local dev).
RESEND_API=
EMAIL_FROM=onboarding@resend.dev

# ── AI synthesis (Gemini) ────────────────────────────────────────────────
# Without a key the app serves deterministic offline briefs.
GEMINI_API_KEY=
GEMINI_MODEL=

# ── Data enrichment (all optional) ───────────────────────────────────────
FINNHUB_API_KEY=
YOUTUBE_API_KEY=
BRAVE_API_KEY=
